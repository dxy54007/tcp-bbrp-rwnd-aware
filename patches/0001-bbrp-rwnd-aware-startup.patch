+/* Return true if the sender's congestion window exceeds the receiver's
+ * advertised window, i.e. the connection is receive-window-limited.
+ */
+static bool bbrp_is_rwnd_limited(struct sock *sk)
+{
+	struct tcp_sock *tp = tcp_sk(sk);
+
+	return (u64)tcp_snd_cwnd(tp) * tp->mss_cache > tp->snd_wnd;
+}
